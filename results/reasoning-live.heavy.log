    } else if (s >= curS || Math.random() < Math.exp((s-curS)/T)){
      cur = cand; curS = s; stuck++;
    } else {
      stuck++;
      if (stuck % 18 === 0){ cur = clone(best); curS = bestS; }
    }
    if (Date.now() - lastImp > 90000 && it % 10 === 0){
      cur = clone(best); curS = bestS; stuck += 12; lastImp = Date.now(); // strong re-kick around best
    }
    if ((Date.now()-t0)/1000 - lastTraceSec >= 10){
      lastTraceSec = (Date.now()-t0)/1000;
      trace.push([+lastTraceSec.toFixed(2), +bestS.toFixed(9)]);
    }
  }
  finalRepair(best);
  trace.push([+((Date.now()-t0)/1000).toFixed(2), +bestS.toFixed(9)]);
  return { solution: best, trace: trace };
