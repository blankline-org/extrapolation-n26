perturb:

```js
  function perturb(c, strength){
    const u = Math.random();
    if (u < 0.28){
      const k=1+Math.floor(Math.random()*3);
      for (let t=0;t<k;t++){
        const i=Math.floor(Math.random()*N);
        const a=Math.random()*6.283185307179586;
        const m=strength*(0.25+Math.random());
        c[i][0]+=Math.cos(a)*m; c[i][1]+=Math.sin(a)*m;
      }
    } else if (u < 0.47){
      // role swap with neighbor
      const i=Math.floor(Math.random()*N);
      const nb=nearestIdx(c,i,5);
      let j=nb[0], bd=-1;
      for (let q=0;q<nb.length;q++){ const dd=Math.abs(c[nb[q]][2]-c[i][2]); if (dd>bd){bd=dd;j=nb[q];} }
      const tmp=c[i][2]; c[i][2]=c[j][2]; c[j][2]=tmp;
    } else if (u < 0.60){
      // swap positions of two circles
      const i=Math.floor(Math.random()*N);
      let j=Math.floor(Math.random()*N); if (j===i) j=(j+1)%N;
      const tx=c[i][0], ty=c[i][1];
      c[i][0]=c[j][0]; c[i][1]=c[j][1]; c[j][0]=tx; c[j][1]=ty;
    } else if (u < 0.76){
      // rotate a local cluster rigidly
      const i=Math.floor(Math.random()*N);
      const sz=3+Math.floor(Math.random()*4);
      const nb=nearestIdx(c,i,sz); nb.push(i);
      let cx=0, cy=0;
      for (let q=0;q<nb.length;q++){ cx+=c[nb[q]][0]; cy+=c[nb[q]][1]; }
      cx/=nb.length; cy/=nb.length;
      const th=(Math.random()<0.5?-1:1)*(0.25+Math.random()*1.3);
      const co=Math.cos(th), si=Math.sin(th);
      for (let q=0;q<nb.length;q++){
        const k=nb[q];
        const dx=c[k][0]-cx, dy=c[k][1]-cy;
        c[k][0]=cx+dx*co-dy*si;
        c[k][1]=cy+dx*si+dy*co;
      }
    } else if (u < 0.90){
      // move one circle to the best sampled hole
      let i=Math.floor(Math.random()*N);
      if (Math.random()<0.5){
        // choose among smaller circles
        let bi=-1, br=1e9;
        for (let t=0;t<6;t++){ const q=Math.floor(Math.random()*N); if (c[q][2]<br){br=c[q][2]; bi=q;} }
        i=bi;
      }
      let bx=c[i][0], by=c[i][1], bc=-1e9;
      for (let s=0;s<70;s++){
        const px=0.02+0.96*Math.random(), py=0.02+0.96*Math.random();
        let cl=Math.min(px,1-px,py,1-py);
        for (let j=0;j<N;j++){
          if (j===i) continue;
          const dx=px-c[j][0], dy=py-c[j][1];
          const dd=Math.sqrt(dx*dx+dy*dy)-c[j][2];
          if (dd<cl) cl=dd;
        }
        if (cl>bc){ bc=cl; bx=px; by=py; }
      }
      c[i][0]=bx; c[i][1]=by;
    } else {
      // global jitter kick
      const mag=strength*0.5;
      for (let i=0;i<N;i++){
        c[i][0]+=(Math.random()+Math.random()+Math.random()-1.5)*mag;
        c[i][1]+=(Math.random()+Math.random()+Math.random()-1.5)*mag;
      }
    }
  }
