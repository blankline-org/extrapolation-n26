```js
  function energy(circ, K){
    // E = -sum r + K/2 * sum hinge^2
    let E = 0;
    for (let i=0;i<N;i++){ E -= circ[i][2]; }
    let pen = 0;
    for (let i=0;i<N;i++){
      const xi=circ[i][0], yi=circ[i][1], ri=circ[i][2];
      let s;
      s = xi - ri; if (s<0) pen += s*s;
      s = 1 - xi - ri; if (s<0) pen += s*s;
      s = yi - ri; if (s<0) pen += s*s;
      s = 1 - yi - ri; if (s<0) pen += s*s;
      for (let j=i+1;j<N;j++){
        const dx = xi - circ[j][0], dy = yi - circ[j][1];
        const d = Math.sqrt(dx*dx+dy*dy);
        const sp = d - ri - circ[j][2];
        if (sp < 0) pen += sp*sp;
      }
    }
    return E + 0.5*K*pen;
  }
```

