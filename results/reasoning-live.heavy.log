```js
  function lpRadii(c, eps){
    const r = new Float64Array(N);
    for (let i=0;i<N;i++) r[i]=0.6;
    const NPairs = N*(N-1)/2;
    const capp = new Float64Array(NPairs);
    {
      let p=0;
      for (let i=0;i<N;i++){
        const xi=c[i][0], yi=c[i][1];
        for (let j=i+1;j<N;j++){
          const dx=xi-c[j][0], dy=yi-c[j][1];
          capp[p]=Math.sqrt(dx*dx+dy*dy)-eps; p++;
        }
      }
    }
    const capb = new Float64Array(N);
    for (let i=0;i<N;i++){
      capb[i]=Math.min(c[i][0],1-c[i][0],c[i][1],1-c[i][1])-eps;
    }
    const pci=new Float64Array(NPairs), pcj=new Float64Array(NPairs);
    const cb=new Float64Array(N), cn=new Float64Array(N);
    let p, i, j;
    for (let sweep=0; sweep<900; sweep++){
      let maxCh=0;
      p=0;
      for (i=0;i<N;i++){
        for (j=i+1;j<N;j++){
          const y0i=r[i]+pci[p], y0j=r[j]+pcj[p];
          const ex=y0i+y0j-capp[p];
          let ni=y0i, nj=y0j;
          if (ex>0){ ni=y0i-ex/2; nj=y0j-ex/2; }
          pci[p]=y0i-ni; pcj[p]=y0j-nj;
          const chi=Math.abs(ni-r[i]), chj=Math.abs(nj-r[j]);
          if (chi>maxCh) maxCh=chi; if (chj>maxCh) maxCh=chj;
          r[i]=ni; r[j]=nj;
          p++;
        }
      }
      for (i=0;i<N;i++){
        let y0=r[i]+cb[i];
