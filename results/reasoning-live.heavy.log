```js
  function gradient(circ, K, g){ // g: Float64Array(3N) zeroed by caller or here
    g.fill(0);
    for (let i=0;i<N;i++){
      const xi=circ[i][0], yi=circ[i][1], ri=circ[i][2];
      g[3*i+2] -= 1; // d(-sum r)/dr
      // boundaries
      let s = xi - ri; 
      if (s<0){ const c=K*s; g[3*i]+=c; g[3*i+2]-=c; }
      s = 1 - xi - ri;
      if (s<0){ const c=K*s; g[3*i]-=c; g[3*i+2]-=c; }
      s = yi - ri;
      if (s<0){ const c=K*s; g[3*i+1]+=c; g[3*i+2]-=c; }
      s = 1 - yi - ri;
      if (s<0){ const c=K*s; g[3*i+1]-=c; g[3*i+2]-=c; }
      for (let j=i+1;j<N;j++){
        const dx = xi - circ[j][0], dy = yi - circ[j][1];
        const d2 = dx*dx+dy*dy;
        const d = Math.sqrt(d2>1e-30?d2:1e-30);
        const sp = d - ri - circ[j][2];
        if (sp<0){
          const c = K*sp; // <0
          // dE/dr_i -= c; dE/dr_j -= c; 
          g[3*i+2] -= c;
          g[3*j+2] -= c;
          const ux = dx/d, uy = dy/d;
          // s depends on x_i via +ux, on x_j via -ux
          g[3*i]   += c*ux;
          g[3*i+1] += c*uy;
          g[3*j]   -= c*ux;
          g[3*j+1] -= c*uy;
        }
      }
    }
    return g;
  }
```

