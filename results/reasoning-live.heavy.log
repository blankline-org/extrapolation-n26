    const T = 6e-5*Math.pow(0.004, Math.min(frac,1));  // ends ~ 2.4e-7
    let cand;
    const doRestart = (it % 45 === 0 && Math.random() < 0.5);
    const doDeep = (it % 20 === 0);
    if (doRestart){ cand = randomConfig(); }
