```js
export default function solve(params) {
  const t0 = Date.now();
  const TIME_LIMIT = 540000;
  const HARD_END = t0 + TIME_LIMIT;
  const N = 26;
  const V = 3 * N;
  const EPS_S = 2.5e-9;
  const trace = [];
  let lastTraceSec = -100;

  function clamped(v, lo, hi){ return v < lo ? lo : (v > hi ? hi : v); }

  function clone(c){
    const b = new Array(N);
    for (let i=0;i<N;i++){ const a=c[i]; b[i]=[a[0],a[1],a[2]]; }
    return b;
  }

  function extract(obj, depth){
    if (!obj || depth > 5) return null;
    if (Array.isArray(obj)){
      if (obj.length === N){
        let ok = true;
        for (let i=0;i<N;i++){
          const e = obj[i];
          if (!Array.isArray(e) || e.length < 3 || typeof e[0] !== 'number' || typeof e[1] !== 'number' || typeof e[2] !== 'number'){ ok=false; break; }
        }
        if (ok) return obj;
      }
      const L = Math.min(obj.length, 40);
      for (let i=0;i<L;i++){ const r = extract(obj[i], depth+1); if (r) return r; }
      return null;
    }
    if (typeof obj === 'object'){
      for (const k in obj){ const r = extract(obj[k], depth+1); if (r) return r; }
    }
    return null;
  }

  function penVal(s, type, w){
    if (s >= 0) return 0;
    return type === 0 ? 0.5*w*s*s : -w*s;
  }
  function penDer(s, type, w){
    if (s >= 0) return 0;
    return type === 0 ? w*s : -w;
  }

  function energy(c, type, w){
    let E = 0, pen = 0;
    for (let i=0;i<N;i++){ E -= c[i][2]; }
    for (let i=0;i<N;i++){
      const ci = c[i]; const xi=ci[0], yi=ci[1], ri=ci[2];
      pen += penVal(xi-ri, type, w);
      pen += penVal(1-xi-ri, type, w);
      pen += penVal(yi-ri, type, w);
      pen += penVal(1-yi-ri, type, w);
      for (let j=i+1;j<N;j++){
        const cj=c[j];
        const dx=xi-cj[0], dy=yi-cj[1];
        const d=Math.sqrt(dx*dx+dy*dy);
        pen += penVal(d-ri-cj[2], type, w);
      }
    }
    return E + pen;
  }
```
Note penVal returns 0.5w s²; and factor: previously E = -Σr + (K/2)s² ✓ matches (w=K). ℓ1: -w*s with s<0 → positive ✓.

```js
  function gradient(c, type, w, g){
    for (let k=0;k<V;k++) g[k]=0;
    for (let i=0;i<N;i++){
      const ci=c[i]; const xi=ci[0], yi=ci[1], ri=ci[2];
      const i3=3*i;
      g[i3+2] -= 1;
      let cv;
      cv = penDer(xi-ri, type, w); if (cv!==0){ g[i3]+=cv; g[i3+2]-=cv; }
      cv = penDer(1-xi-ri, type, w); if (cv!==0){ g[i3]-=cv; g[i3+2]-=cv; }
      cv = penDer(yi-ri, type, w); if (cv!==0){ g[i3+1]+=cv; g[i3+2]-=cv; }
      cv = penDer(1-yi-ri, type, w); if (cv!==0){ g[i3+1]-=cv; g[i3+2]-=cv; }
      for (let j=i+1;j<N;j++){
        const cj=c[j];
        const dx=xi-cj[0], dy=yi-cj[1];
        const d2=dx*dx+dy*dy;
        if (d2 < 1e-24){
          // coincident: only radius derivative matters; add a push in random direction
          const sp = -ri - cj[2];
          const cv2 = penDer(sp, type, w);
          if (cv2!==0){
            g[i3+2]-=cv2; g[3*j+2]-=cv2;
            const ang = (i*7+j*13)%6.283185307179586;
            g[i3]   -= cv2*Math.cos(ang); g[i3+1] -= cv2*Math.sin(ang);
            g[3*j]  += cv2*Math.cos(ang); g[3*j+1] += cv2*Math.sin(ang);
          }
          continue;
        }
        const d=Math.sqrt(d2);
        const sp=d-ri-cj[2];
        const cv2=penDer(sp, type, w);
        if (cv2!==0){
          const j3=3*j;
          g[i3+2]-=cv2; g[j3+2]-=cv2;
          const ux=dx/d, uy=dy/d;
          g[i3]+=cv2*ux; g[i3+1]+=cv2*uy;
          g[j3]-=cv2*ux; g[j3+1]-=cv2*uy;
        }
      }
    }
  }
