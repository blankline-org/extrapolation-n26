function perturb(cand, strength){
  const mode = Math.random();
  if (mode < 0.30){
    // displace k circles individually
    const k = 1 + Math.floor(Math.random()*3);
    for (let t=0;t<k;t++){
      const i = Math.floor(Math.random()*N);
      const a = Math.random()*Math.PI*2;
      const m = strength*(0.3+Math.random());
      cand[i][0] += Math.cos(a)*m;
      cand[i][1] += Math.sin(a)*m;
    }
  } else if (mode < 0.48){
    // role swap: small <-> large neighbor radii
    // pick small circle
    let i = Math.floor(Math.random()*N);
    // find its nearest neighbors
    const nb = nearestIdx(cand, i, 5);
    // choose j maximizing |r_j - r_i|
    let j = nb[0]; let bestd = -1;
    for (...) if (Math.abs(cand[c][2]-cand[i][2]) > bestd) {...}
    swap radii: const tmp = cand[i][2]; cand[i][2]=cand[j][2]; cand[j][2]=tmp;
    // also slight nudge
  } else if (mode < 0.60){
    // swap positions of two random circles (radii stay with circle)
    pick i,j; swap x,y (full swap including radii = swap whole entries except index) — swap positions only.
  } else if (mode < 0.75){
    // cluster rotation
    const i = rand; const nb = [i] ∪ nearest 4-6; centroid of nb; rotate θ = (Math.random()<0.5?-1:1)*(0.3+Math.random()*1.2);
