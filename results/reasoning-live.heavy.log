  function nearestIdx(c, i, m){
    const d = [];
    for (let j=0;j<N;j++){ if (j!==i){ const dx=c[i][0]-c[j][0], dy=c[i][1]-c[j][1]; d.push([dx*dx+dy*dy, j]); } }
    d.sort(function(a,b){return a[0]-b[0];});
    const out=[];
    for (let k=0;k<Math.min(m,d.length);k++) out.push(d[k][1]);
    return out;
  }
