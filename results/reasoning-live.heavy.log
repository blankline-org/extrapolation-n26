finalRepair:

```js
  function finalRepair(c){
    clampCenters(c);
    let eps = EPS_S;
    for (let attempt=0; attempt<6; attempt++){
      const r = lpRadii(c, eps);
      shrinkExact(c, r, eps);
      for (let i=0;i<N;i++) c[i][2]=r[i];
      if (validate(c)) return true;
      eps *= 3;
    }
    return validate(c);
  }

  function validate(c){
    for (let i=0;i<N;i++){
      const ci=c[i];
      if (!(ci[2] > 0)) return false;
      if (ci[0]-ci[2] < 1e-12) return false;
      if (1-ci[0]-ci[2] < 1e-12) return false;
      if (ci[1]-ci[2] < 1e-12) return false;
      if (1-ci[1]-ci[2] < 1e-12) return false;
      for (let j=i+1;j<N;j++){
        const dx=ci[0]-c[j][0], dy=ci[1]-c[j][1];
        const d=Math.sqrt(dx*dx+dy*dy);
        if (d-(ci[2]+c[j][2]) < 1e-12) return false;
      }
    }
    return true;
  }
```

