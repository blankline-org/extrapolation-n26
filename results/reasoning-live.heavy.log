  function optimize(c, endTime, quick){
    const g = new Float64Array(V);
    const stages = quick
      ? [[0,1e2,450],[0,1e4,500],[0,1e6,500],[1,60,300],[1,400,300]]
      : [[0,1e2,900],[0,1e4,1100],[0,1e6,1100],[1,60,700],[1,400,700]];
    const trial = new Array(N);
    for (let i=0;i<N;i++) trial[i]=[0,0,0];
    const v = new Float64Array(V);
    for (let s=0;s<stages.length;s++){
      const type=stages[s][0], w=stages[s][1], maxIt=stages[s][2];
      v.fill(0);
      let lr = 1e-3;
      let E = energy(c, type, w);
      let windowStartE = E;
      let itWindow = 0;
      for (let it=0; it<maxIt; it++){
        if ((it & 127) === 0 && Date.now() > endTime) return;
        gradient(c, type, w, g);
        let gmax = 0;
        for (let k=0;k<V;k++){ const a=Math.abs(g[k]); if (a>gmax) gmax=a; v[k]=0.9*v[k]+g[k]; }
        if (gmax < 1e-11) break;  // hmm for ℓ1 gradient never < w... remove? keep: means fully feasible & stationary
        let accepted = false;
        for (let ls=0; ls<24; ls++){
          for (let i=0;i<N;i++){
            const i3=3*i, ci=c[i], ti=trial[i];
            ti[0]=ci[0]-lr*v[i3]; ti[1]=ci[1]-lr*v[i3+1]; 
            let nr=ci[2]-lr*v[i3+2]; if (nr<1e-7) nr=1e-7; else if (nr>0.5) nr=0.5;
            ti[2]=nr;
            if (ti[0]<-0.3) ti[0]=-0.3; else if (ti[0]>1.3) ti[0]=1.3;
            if (ti[1]<-0.3) ti[1]=-0.3; else if (ti[1]>1.3) ti[1]=1.3;
          }
          const Et = energy(trial, type, w);
          if (isFinite(Et) && Et < E - 1e-16){
            for (let i=0;i<N;i++){ const ci=c[i], ti=trial[i]; ci[0]=ti[0]; ci[1]=ti[1]; ci[2]=ti[2]; }
            E = Et; lr *= 1.35; accepted = true; break;
          }
          lr *= 0.5;
          if (lr < 1e-14) break;
        }
        if (!accepted){ v.fill(0); if (lr<1e-14) break; }
        // window stagnation check
        itWindow++;
        if (itWindow >= 150){
          if (windowStartE - E < 5e-12*(1+Math.abs(E))) { /* little progress */ 
            // only break stage if very small gradient or nearly feasible tiny energy drop
            if (windowStartE - E < 5e-13) break;
          }
          windowStartE = E; itWindow=0;
        }
      }
    }
  }
