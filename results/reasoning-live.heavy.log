```js
  function shrinkExact(c, r, eps){
    // boundary
    for (let i=0;i<N;i++){
      const ci=c[i];
      let cap = Math.min(ci[0], 1-ci[0], ci[1], 1-ci[1]) - eps;
      if (r[i] > cap) r[i] = cap;
      if (r[i] < 1e-9) r[i] = 1e-9;
    }
    for (let iter=0; iter<400; iter++){
      let bad = false;
      for (let i=0;i<N;i++){
        const ci=c[i];
        for (let j=i+1;j<N;j++){
          const cj=c[j];
          const dx=ci[0]-cj[0], dy=ci[1]-cj[1];
          const d=Math.sqrt(dx*dx+dy*dy);
          const lim = d - eps;
          const need = r[i]+r[j]-lim;
          if (need > 0){
            bad = true;
            let take;
            if (r[i] >= r[j]){
              take = Math.min(need, r[i]-1e-9); r[i]-=take; 
              const rem = need-take; if (rem>0) r[j]=Math.max(1e-9, r[j]-rem);
            } else {
              take = Math.min(need, r[j]-1e-9); r[j]-=take;
              const rem = need-take; if (rem>0) r[i]=Math.max(1e-9, r[i]-rem);
            }
          }
        }
      }
      if (!bad) break;
    }
    return r;
  }
```

