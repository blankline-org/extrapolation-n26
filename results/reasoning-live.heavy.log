```
function optimize(circ, endTime, knobs){
  const Ks = knobs.Ks; const itPer = knobs.itPer;
  const g = new Float64Array(3*N);
  for (let s=0; s<Ks.length; s++){
    const K = Ks[s];
    let v = new Float64Array(3*N);
    let lr = knobs.lr0; 
    let E = energy(circ, K);
    let noImp = 0;
    for (let it=0; it<itPer; it++){
      if ((it & 127) === 0 && Date.now() > endTime) return;
      gradient(circ, K, g);
      // momentum update
      for k: v[k] = 0.9*v[k] + g[k];
      // normalize maybe
      let acc=false;
      for (let ls=0; ls<25; ls++){
        // trial
        for i: for k: trial[i][k] = circ[i][k] - lr*v[k];
        clamp trial radii [1e-7,0.5], positions [-0.5,1.5]?? clamping positions far outside kills gradient info but protects. clamp to [-0.25,1.25].
        Et = energy(trial,K)
        if (Et < E - 1e-15){ accept: copy trial→circ (or swap references), E=Et, lr*=1.35, acc=true; break;}
        else lr *= 0.5;
      }
      if (!acc){ v.fill(0); if (lr < 1e-13) break; }
      else noImp tracking...
      // early stop if gradient small? if maxAbs(g) < 1e-9 maybe break;
    }
  }
}
```

